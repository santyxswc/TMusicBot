# Configuración del Bot de Telegram para Descargar Música
# 
# Instrucciones:
# 1. Ve a Telegram y busca @BotFather
# 2. Envía el comando /newbot y sigue las instrucciones
# 3. Copia el token que te proporciona y pégalo aquí abajo
# 4. Renombra este archivo a .env (sin .example)

TELEGRAM_TOKEN=AQUÍ_TU_TOKEN
